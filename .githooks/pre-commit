#!/bin/sh
# 触发范围与安全门统一由 scripts/project_checks.py 维护。
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$ROOT" || exit 1
PY="${SHANGKE_PYTHON:-}"
[ -z "$PY" ] && PY="$(git config --get shangke.python 2>/dev/null)"
if [ -z "$PY" ]; then
  for candidate in python python3 py; do
    if command -v "$candidate" >/dev/null 2>&1; then PY="$candidate"; break; fi
  done
fi
if [ -z "$PY" ]; then
  echo "[checks] ERROR：未找到 Python，安全门未执行；请设置 shangke.python 后重试。" >&2
  exit 1
fi
exec "$PY" scripts/project_checks.py --staged
