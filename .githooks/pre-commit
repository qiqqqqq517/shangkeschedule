#!/bin/sh
# ---------------------------------------------------------------------------
# A1 主题系统收口 · pre-commit 门禁（棘轮式）
#
# 语义：**存量违规允许存在，但不得增加**。规则立即生效，又不冻结开发。
# 规则定义：docs/design-system.md（R1–R4）
# 校验器  ：scripts/check_theme_leak.py
# 基线    ：scripts/theme-leak-baseline.json（只允许下降）
#
# 启用：git config core.hooksPath .githooks
# 关闭：git config --unset core.hooksPath
# 跳过单次：git commit --no-verify
# ---------------------------------------------------------------------------

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$ROOT" ] && exit 0
cd "$ROOT" || exit 0

# 找 python：环境变量 → git config → PATH。找不到则 fail-open（不阻断提交）。
PY="${SHANGKE_PYTHON:-}"
[ -z "$PY" ] && PY="$(git config --get shangke.python 2>/dev/null)"
if [ -z "$PY" ]; then
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
  done
fi
if [ -z "$PY" ]; then
  echo "[theme-leak] 未找到 python，跳过主题系统校验（不阻断提交）。" >&2
  echo "[theme-leak] 可设置：git config shangke.python <python 路径>" >&2
  exit 0
fi

"$PY" scripts/check_theme_leak.py --baseline scripts/theme-leak-baseline.json --quiet
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "[theme-leak] 提交被拦截：主题系统违规数高于基线（见上方明细）。" >&2
  echo "  看完整报告：python scripts/check_theme_leak.py" >&2
  echo "  确认属预期：python scripts/check_theme_leak.py --update-baseline scripts/theme-leak-baseline.json" >&2
  echo "  本次跳过  ：git commit --no-verify" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 小组件配色对比度门禁（**绝对式**：0 违规，非棘轮）
#
# 背景：小组件自带一套独立色表（androidApp/.../values{,-night}/colors.xml），
#       不参与 App 主题 token 体系，上面的 check_theme_leak.py 覆盖不到它。
# 规则：文本 ≥4.5:1、有意义的非文本 UI ≥3:1（WCAG 2.2 AA），且不得出现已废弃色名。
# 依据：docs/widget-display-optimization.md §6.6 / §8 V1–V2、V15
# ---------------------------------------------------------------------------
"$PY" scripts/check_widget_contrast.py --quiet
WSTATUS=$?

# ---------------------------------------------------------------------------
# AC2 无障碍语义门禁（棘轮式）
#
# 背景：contentDescription = null **本身不是缺陷** —— 图标与文字同处一个可读节点时，
#       保持 null 才是正确做法，否则 TalkBack 会重复播报。全库 54 处 null 里约 46 处
#       属于这种情形。因此门禁数的是「真正不可辨识的可操作节点」，不是 null 的个数。
# 规则：A 类 独立图标按钮无描述；B 类 可点击节点无文字且无语义声明。
# 校验器：scripts/check_a11y.py     基线：scripts/a11y-baseline.json
# ---------------------------------------------------------------------------
"$PY" scripts/check_a11y.py --baseline scripts/a11y-baseline.json
ASTATUS=$?

if [ "$ASTATUS" -ne 0 ]; then
  echo "" >&2
  echo "[a11y] 提交被拦截：无障碍语义违规数高于基线（见上方明细）。" >&2
  echo "  看完整报告：python scripts/check_a11y.py --baseline scripts/a11y-baseline.json" >&2
  echo "  确认属预期：追加 --update-baseline scripts/a11y-baseline.json" >&2
  echo "  本次跳过  ：git commit --no-verify" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 红线文件守卫（**绝对式**：命中即拦截，无棘轮、无基线）
#
# 背景：AGENTS.md 明令 *.jks / keystore.properties / local.properties /
#       google-services.json 不得入库；签名密钥当前仅存本机，一旦被
#       `git add .` 带进历史就是永久泄露（改写历史成本极高）。
#       配合"git add 禁止 . / -A、必须显式列文件"的纪律，这里给出机器兜底。
# 放行：确属误报时用 `git commit --no-verify`，但请先确认该文件真的可以入库。
# ---------------------------------------------------------------------------
STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)"

FORBIDDEN=""
echo "$STAGED" | while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.jks|*.keystore|*/keystore.properties|keystore.properties|*/local.properties|local.properties|*/google-services.json|google-services.json|adapter_secrets.properties|*/adapter_secrets.properties)
      echo "$f" ;;
  esac
done > "$(git rev-parse --git-dir)/shangke-forbidden.tmp" 2>/dev/null
FORBIDDEN="$(cat "$(git rev-parse --git-dir)/shangke-forbidden.tmp" 2>/dev/null)"

if [ -n "$FORBIDDEN" ]; then
  echo "" >&2
  echo "[redline] 提交被拦截：以下文件是 AGENTS.md 明令禁止入库的红线文件（密钥/本地配置/私有适配密钥）：" >&2
  echo "$FORBIDDEN" | sed 's/^/    - /' >&2
  echo "  取消暂存：git restore --staged <文件>" >&2
  echo "  确认无敏感内容后再提交；确属误报：git commit --no-verify" >&2
  rm -f "$(git rev-parse --git-dir)/shangke-forbidden.tmp"
  exit 1
fi
rm -f "$(git rev-parse --git-dir)/shangke-forbidden.tmp"

# ---------------------------------------------------------------------------
# 教务适配脚本门禁（**条件触发**：仅当暂存区碰了适配脚本时才跑）
#
# 背景：适配脚本（178 校 / 196 文件）是产品的护城河，却零自动化测试；
#       check_adapters.py 已覆盖 —— 入口契约、双落点(主仓库↔私有仓)一致性、
#       裸原生对话框、危险 API、require/catch、孤儿脚本、node --check 语法。
# 为何条件触发：全量跑含 196 次 node --check 约 13 秒，若每次都跑，几天内必然被
#       `--no-verify` 绕过。这里只在暂存区确实动了适配脚本时触发，并用 --skip-node
#       压到 ~1.8 秒（结构/双落点/孤儿照查）；含 --skip-node 的全量校验请留在
#       发版 runbook 与 CI 前置检查里跑。
# 放行：确属误报：python scripts/check_adapters.py --strict（看明细）或 --no-verify。
# ---------------------------------------------------------------------------
ADAPTER_TOUCHED="$(echo "$STAGED" | grep -E '^(shared/assets/offline_repo/|\.adapter_private/|adapter-worker/)' || true)"
if [ -n "$ADAPTER_TOUCHED" ]; then
  echo "[adapters] 检测到适配脚本改动，运行适配置体检（--skip-node）..." >&2
  # --require-private：**改了适配脚本却没有私有仓库工作副本**时直接拦截。
  #
  # 背景（2026-10-04 OTA 事故的核心防线）：
  #   双落点校验（主仓库 ↔ 私有仓一致性）只有在 .adapter_private 存在时才运行；
  #   缺失时旧版脚本只记 WARN，而 WARN 默认不影响退出码 ⇒ 门禁静默变绿。
  #   而「新 worktree / 未 clone 私有仓库」恰恰是最需要这条防线的场景：
  #   远端比包内旧 ⇒ AdapterRemoteUpdater.sync() 用旧版覆盖包内新脚本，
  #   症状为「原有功能正常、本次新增功能全失效」，极难排查。
  # 因此：一旦本次提交**确实改了适配脚本**，就要求私有仓库必须在场。
  "$PY" scripts/check_adapters.py --skip-node --require-private
  ADSTATUS=$?
  if [ "$ADSTATUS" -ne 0 ]; then
    echo "" >&2
    echo "[adapters] 提交被拦截：教务适配脚本存在 ERROR（见上方明细）。" >&2
    echo "  看完整报告（含 node 语法校验）：python scripts/check_adapters.py" >&2
    echo "  若本机确实拿不到私有仓库（未 clone）：git commit --no-verify" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 版本号一致性门禁（**条件触发**：仅当暂存区碰了版本源或官网时）
#
# 背景：发版时版本号被写进多处；androidApp/build.gradle.kts 是 APK 真实版本，
#       website/assets/js/site.js 的 SITE.version 在运行时覆写官网页所有
#       data-version 占位符。两者一旦漂移，用户从官网点下载拿到的是旧包 —— 而本
#       repo 的 tools/ 整目录被 gitignore，负责同步的 update_website.py 在新
#       worktree 里根本不存在，漂移可以完全静默地发生。
# 说明：scripts/check_version_sync.py 只对齐 (1)(2) 两个文件的四个字段，
#       不涉及 CHANGELOG / GitHub Release（那两者无机器可校验锚点）。
#       注意：纯工具链提交会 bump versionName 但不出 Release，此时
#       site.js 同步到新版本、changelog.html 停留在上一已发布版本 —— 这是
#       update_website.py 的既有设计，不是违规，本门禁不涉及这一点。
# 放行：确属误报：git commit --no-verify
# ---------------------------------------------------------------------------
VERSION_TOUCHED="$(echo "$STAGED" | grep -E '^(androidApp/build\.gradle\.kts|website/assets/js/site\.js|CHANGELOG\.md)$' || true)"
if [ -n "$VERSION_TOUCHED" ]; then
  "$PY" scripts/check_version_sync.py --quiet
  VSTATUS=$?
  if [ "$VSTATUS" -ne 0 ]; then
    echo "" >&2
    echo "[version] 提交被拦截：版本号不一致（见上方明细）。" >&2
    echo "  APK 真实版本源：androidApp/build.gradle.kts" >&2
    echo "  官网页版本源  ：website/assets/js/site.js" >&2
    echo "  本次跳过      ：git commit --no-verify" >&2
    exit 1
  fi
fi

exit 0
