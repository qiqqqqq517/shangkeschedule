<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!--
      FIX: WebDAV 凭据所在的 DataStore 不参与自动备份。
      密文本身由 AndroidKeyStore 的设备绑定密钥保护，但服务器地址与用户名
      没有上传到云端的必要；换机恢复后重新填写即可。
    -->
    <exclude domain="file" path="datastore/api_config.preferences_pb" />
    <!--
      FIX: DataStore 写入时先生成同目录伴生文件 <path>.tmp 再原子改名，崩溃或被系统杀死
      会残留内容与正本相同的副本。AOSP 对 domain="file" 的排除是精确路径匹配，只在
      database 域补 -journal/-wal、sharedpref 域补 .xml，不会连带排除伴生文件。
    -->
    <exclude domain="file" path="datastore/api_config.preferences_pb.tmp" />
</full-backup-content>