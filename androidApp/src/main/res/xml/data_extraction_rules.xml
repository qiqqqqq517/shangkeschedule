<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          FIX: 排除 WebDAV 凭据文件（datastore/api_config.preferences_pb），
          其余课程数据仍参与云备份，保证换机可恢复课表。
        -->
        <exclude domain="file" path="datastore/api_config.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- FIX: 设备间迁移同样排除凭据文件。 -->
        <exclude domain="file" path="datastore/api_config.preferences_pb" />
    </device-transfer>
</data-extraction-rules>