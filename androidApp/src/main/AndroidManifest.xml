<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 早八闹钟：normal 级权限，仅用于通过 AlarmClock Intent 写入系统时钟应用 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      包可见性（Android 11+ / targetSdk 37）：早八写入系统时钟前用
      `packageManager.resolveActivity(ACTION_SET_ALARM)` 探测「是否装了时钟应用」。
      该查询受包可见性过滤，缺此声明会恒返回 null → 早八永远走应用内降级、永远写不进
      系统时钟；且因为「没发生交互」，可见性也不会事后自动补授，形成自锁。
      startActivity 本身不受过滤，所以缺声明时是「探测失败、写入从未尝试」。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.shangkeschedule"
        tools:targetApi="33"
        android:enableOnBackInvokedCallback="true">

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.shangkeschedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DynamicIslandService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="状态栏实时显示当前/下一节课状态" />
        </service>

        <receiver
            android:name=".service.DynamicIslandAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".service.notification.receiver.ReminderAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".service.notification.receiver.AutoModeAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 旧版课程/自动模式闹钟接收器：冻结保留一版做升级兵底。
             升级安装后旧版已排下的闹钟会指向本类，待 LegacyAlarmMigrator 首次运行清理完毕。
             下个大版本连同 LegacyAlarmMigrator 一并移除。 -->
        <receiver
            android:name=".service.CourseAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".service.BootEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <!-- 只保留 BOOT_COMPLETED：LOCKED_BOOT_COMPLETED 只投递给
                     android:directBootAware="true" 的组件，本应用未声明（也不应声明 ——
                     Room/DataStore 全为 credential-protected，解锁前读不到库），且
                     BootEventReceiver 本身也只处理 ACTION_BOOT_COMPLETED。
                     故该 action 是永不投递的死配置，删之。 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 应用升级即时刷新小组件：升级后桌面残留旧版渲染，打开 App 前推一次全量渲染。 -->
        <receiver
            android:name=".widget.WidgetPackageReplacedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.tiny.TinyNativeProvider"
            android:label="@string/widget_name_tiny"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shangkeschedule_tiny_widget" />
        </receiver>

        <receiver
            android:name=".widget.compact.CompactNativeProvider"
            android:label="@string/widget_name_compact"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shangkeschedule_compact_widget" />
        </receiver>


        <receiver
            android:name=".widget.double_days.DoubleDaysNativeProvider"
            android:label="@string/widget_name_double_days"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shangkeschedule_double_days_widget" />
        </receiver>

        <receiver
            android:name=".widget.list_vertical.ListVerticalNativeProvider"
            android:exported="false"
            android:label="@string/widget_name_list_vertical">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shangkeschedule_list_vertical_widget" />
        </receiver>



        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>